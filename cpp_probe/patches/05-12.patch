 void BBoxDeviceContext::EndGraphic(Object *object, View *view)
 {
+    if (!probe::ActivePass().empty() && probe::Stream()) {
+        const std::string fn = probe::ActivePass();
+        const int pass = probe::CurrentPass(fn);
+        probe::Emit("{\"fn\":\"%s\",\"pass\":%d,\"path\":\"%s\",\"id\":\"%s\",\"class\":\"%s\""
+                    ",\"selfX1\":%d,\"selfX2\":%d,\"selfY1\":%d,\"selfY2\":%d"
+                    ",\"contentX1\":%d,\"contentX2\":%d,\"contentY1\":%d,\"contentY2\":%d}\n",
+            probe::Json(fn).c_str(), pass, probe::Path(object).c_str(), probe::Id(object).c_str(),
+            probe::Json(object->GetClassName()).c_str(),
+            object->GetSelfX1(), object->GetSelfX2(), object->GetSelfY1(), object->GetSelfY2(),
+            object->GetContentX1(), object->GetContentX2(), object->GetContentY1(), object->GetContentY2());
+    }
     // detach the object
     assert(m_objects.back() == object);
     m_objects.pop_back();
