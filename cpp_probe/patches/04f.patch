 //----------------------------------------------------------------------------
 
@@ -26,22 +27,44 @@
 
 FunctorCode CacheHorizontalLayoutFunctor::VisitArpeg(Arpeg *arpeg)
 {
+    // [cpp_probe] on the store pass (m_restore=false) xRelBefore==xRelAfter==the value written to
+    // the cache (CacheXRel does not touch m_drawingXRel then); on the restore pass (m_restore=true)
+    // xRelAfter is the value that had been cached (CacheXRel writes it back into m_drawingXRel).
+    const int probeXRelBefore = arpeg->GetDrawingXRel();
     arpeg->CacheXRel(m_restore);
+    probe::Emit("{\"fn\":\"CacheHorizontalLayout\",\"sub\":\"VisitArpeg\",\"path\":\"%s\",\"restore\":%d"
+                ",\"xRelBefore\":%d,\"xRelAfter\":%d}\n",
+        probe::Path(arpeg).c_str(), m_restore ? 1 : 0, probeXRelBefore, arpeg->GetDrawingXRel());
 
     return FUNCTOR_CONTINUE;
 }
 
 FunctorCode CacheHorizontalLayoutFunctor::VisitLayerElement(LayerElement *layerElement)
 {
+    // [cpp_probe] same before/after reasoning as VisitArpeg, for both xRel and yRel.
+    const int probeXRelBefore = layerElement->GetDrawingXRel();
+    const int probeYRelBefore = layerElement->GetDrawingYRel();
     layerElement->CacheXRel(m_restore);
     layerElement->CacheYRel(m_restore);
+    probe::Emit("{\"fn\":\"CacheHorizontalLayout\",\"sub\":\"VisitLayerElement\",\"path\":\"%s\",\"restore\":%d"
+                ",\"xRelBefore\":%d,\"xRelAfter\":%d,\"yRelBefore\":%d,\"yRelAfter\":%d}\n",
+        probe::Path(layerElement).c_str(), m_restore ? 1 : 0, probeXRelBefore, layerElement->GetDrawingXRel(),
+        probeYRelBefore, layerElement->GetDrawingYRel());
 
     return FUNCTOR_CONTINUE;
 }
 
 FunctorCode CacheHorizontalLayoutFunctor::VisitMeasure(Measure *measure)
 {
+    // [cpp_probe] Measure also exposes GetCachedXRel() publicly, so we can record the cache slot
+    // directly in addition to the before/after reasoning used for Arpeg / LayerElement.
+    const int probeXRelBefore = measure->GetDrawingXRel();
+    const int probeCachedBefore = measure->GetCachedXRel();
     measure->CacheXRel(m_restore);
+    probe::Emit("{\"fn\":\"CacheHorizontalLayout\",\"sub\":\"VisitMeasure\",\"path\":\"%s\",\"restore\":%d"
+                ",\"xRelBefore\":%d,\"xRelAfter\":%d,\"cachedBefore\":%d,\"cachedAfter\":%d}\n",
+        probe::Path(measure).c_str(), m_restore ? 1 : 0, probeXRelBefore, measure->GetDrawingXRel(),
+        probeCachedBefore, measure->GetCachedXRel());
 
     if (measure->GetLeftBarLine()) this->VisitBarLine(measure->GetLeftBarLine());
     if (measure->GetRightBarLine()) this->VisitBarLine(measure->GetRightBarLine());
