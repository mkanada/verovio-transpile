+            probe::CurrentPass("CalcAlignmentXPos"), probeMPath.c_str(), probeId.c_str(), probeAlIndex,
+            static_cast<int>(alignment->GetType()), alignment->GetTime().GetNumerator(),
+            alignment->GetTime().GetDenominator(), s_probeMeasureSeq, probeXRelIn, alignment->GetXRel());
+    }
     if (alignment->GetType() <= ALIGNMENT_MEASURE_LEFT_BARLINE) return FUNCTOR_CONTINUE;
 
     int intervalXRel = 0;
@@ -45,6 +79,12 @@
     // Do not move aligners that are only time-stamps at this stage but add it to the pending list
     if (alignment->HasTimestampOnly()) {
         m_timestamps.push_back(alignment);
