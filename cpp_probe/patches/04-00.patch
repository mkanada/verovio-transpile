@@ -32,7 +42,31 @@
 
 FunctorCode CalcAlignmentXPosFunctor::VisitAlignment(Alignment *alignment)
 {
+    // [cpp_probe] read-only capture of the incoming state. The matching key is
+    // the measure path plus the 0-based index of the alignment among the
+    // children of its MeasureAligner (Alignment has no registered class name,
+    // so probe::Path cannot identify it).
+    const Object *probeParent = alignment->GetParent();
+    int probeAlIndex = 0;
+    if (probeParent) {
+        for (const Object *probeChild : probeParent->GetChildren()) {
+            if (probeChild == alignment) break;
+            ++probeAlIndex;
+        }
+    }
+    const std::string probeMPath = probe::Path(alignment->GetFirstAncestor(MEASURE));
+    const std::string probeId = probe::Id(alignment);
+    const int probeXRelIn = alignment->GetXRel();
+
     // Do not set an x pos for anything before the barline (including it)
+    // [cpp_probe] read-only capture of the barline-skipped alignment
+    if (alignment->GetType() <= ALIGNMENT_MEASURE_LEFT_BARLINE) {
+        probe::Emit("{\"fn\":\"CalcAlignmentXPos\",\"pass\":%d,\"mpath\":\"%s\",\"id\":\"%s\",\"al\":%d"
