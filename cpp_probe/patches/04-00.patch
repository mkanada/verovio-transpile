 #include "vrv.h"
+#include "vrvprobe.h"
 #include "zone.h"
 
 //----------------------------------------------------------------------------
@@ -2021,6 +2022,26 @@
 
 int Doc::GetDrawingUnit(int staffSize) const
 {
+    // [cpp_probe] read-only capture of the option-level drawing values, once
+    // per process (the probe runs one document per invocation).
+    static bool s_unitsEmitted = false;
+    if (!s_unitsEmitted) {
+        s_unitsEmitted = true;
+        probe::Emit(
+            "{\"fn\":\"Units\",\"kind\":\"doc\""
+            ",\"unit\":%.17g"
+            ",\"drawingUnit100\":%d"
+            ",\"drawingDoubleUnit100\":%d"
+            ",\"drawingStaffSize100\":%d"
+            ",\"pageWidth\":%d,\"pageHeight\":%d"
+            ",\"pageMarginBottom\":%d,\"pageMarginLeft\":%d"
+            ",\"pageMarginRight\":%d,\"pageMarginTop\":%d}\n",
+            m_options->m_unit.GetValue(), this->GetDrawingUnit(100), this->GetDrawingDoubleUnit(100),
+            this->GetDrawingStaffSize(100), m_options->m_pageWidth.GetValue(), m_options->m_pageHeight.GetValue(),
+            m_options->m_pageMarginBottom.GetValue(), m_options->m_pageMarginLeft.GetValue(),
+            m_options->m_pageMarginRight.GetValue(), m_options->m_pageMarginTop.GetValue());
+    }
+
     return m_options->m_unit.GetValue() * staffSize / 100;
 }
 
