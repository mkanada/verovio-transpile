 FunctorCode CalcAlignmentXPosFunctor::VisitMeasure(Measure *measure)
 {
+    // [cpp_probe] advance the measure sequence number
+    ++s_probeMeasureSeq;
+
+    // [cpp_probe] read-only capture of the per-staff drawing values, once per
+    // process, the first time a measure is visited (drawing staff sizes are
+    // resolved by then).
+    static bool s_staffEmitted = false;
+    if (!s_staffEmitted) {
+        s_staffEmitted = true;
+        ListOfObjects probeStaves = m_doc->FindAllDescendantsByType(STAFF);
+        std::map<int, int> probeSeen;
+        for (const Object *probeObject : probeStaves) {
+            const Staff *probeStaff = dynamic_cast<const Staff *>(probeObject);
+            if (!probeStaff || probeStaff->m_drawingStaffSize <= 0) continue;
+            const int probeStaffN = probeStaff->GetN();
+            if ((probeStaffN != VRV_UNSET) && !probeSeen.count(probeStaffN)) {
+                probeSeen[probeStaffN] = probeStaff->m_drawingStaffSize;
+                const int probeSize = probeStaff->m_drawingStaffSize;
+                probe::Emit("{\"fn\":\"Units\",\"kind\":\"staff\",\"staffN\":%d,\"staffSize\":%d"
+                            ",\"drawingUnit\":%d,\"drawingDoubleUnit\":%d,\"drawingStaffSize\":%d}\n",
+                    probeStaffN, probeSize, m_doc->GetDrawingUnit(probeSize),
+                    m_doc->GetDrawingDoubleUnit(probeSize), m_doc->GetDrawingStaffSize(probeSize));
+            }
+        }
+    }
+
     // We start a new Measure
     // Reset the previous time position and x_rel to 0;
     m_previousTime = 0;
