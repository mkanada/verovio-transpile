+# [cpp_probe] snapshot — the state-dump runtime lives outside this tree, in
+# cpp_probe/snapshot/ (see cpp_probe/README.md, "Snapshot"). It is compiled with
+# -fno-access-control so it can read protected/private members directly.
+set(VRV_SNAPSHOT_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../../cpp_probe/snapshot")
+file(GLOB snapshot_SRC "${VRV_SNAPSHOT_DIR}/*.cpp")
+include_directories(${VRV_SNAPSHOT_DIR})
+set_source_files_properties(${snapshot_SRC} PROPERTIES COMPILE_OPTIONS "-fno-access-control")
+list(APPEND all_SRC ${snapshot_SRC})
+
