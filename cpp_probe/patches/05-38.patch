 //----------------------------------------------------------------------------
+// Drawing probe — 05-38: global seq + current-object stack
+//----------------------------------------------------------------------------
+
+inline int &DrawSeqCounter()
+{
+    static int s = 0;
+    return s;
+}
+
+inline std::vector<const Object *> &DrawObjectStack()
+{
+    static std::vector<const Object *> s;
+    return s;
+}
+
+inline int NextDrawSeq()
+{
+    return ++DrawSeqCounter();
+}
+
+inline void PushDrawObject(const Object *o)
+{
+    if (o) DrawObjectStack().push_back(o);
+}
+
+inline void PopDrawObject()
+{
+    if (!DrawObjectStack().empty()) DrawObjectStack().pop_back();
+}
+
+inline const Object *CurrentDrawObject()
+{
+    return DrawObjectStack().empty() ? nullptr : DrawObjectStack().back();
+}
+
+inline std::string Hex4(char32_t c)
+{
+    char buf[8];
+    std::snprintf(buf, sizeof(buf), "%04X", (unsigned int)c);
+    return std::string(buf);
+}
+
+inline std::string U32ToHex(const std::u32string &s)
+{
+    std::string out;
+    for (size_t i = 0; i < s.size(); ++i) {
+        if (i) out += ",";
+        out += Hex4(s[i]);
+    }
+    return out;
+}
+
