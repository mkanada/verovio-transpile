# ---------------------------------------------------------------------------------------------
# Beams: the interface (Beam, FTrem, BeamSpan…) and the Beam's own segment
# ---------------------------------------------------------------------------------------------
layout | BeamDrawingInterface | BeamDrawingInterface | bdPlace | enum | o->m_drawingPlace | o.drawingPlace.value
layout | BeamDrawingInterface | BeamDrawingInterface | bdWidth | int | o->m_beamWidth | o.beamWidth
layout | BeamDrawingInterface | BeamDrawingInterface | bdWidthBlack | int | o->m_beamWidthBlack | o.beamWidthBlack
layout | BeamDrawingInterface | BeamDrawingInterface | bdWidthWhite | int | o->m_beamWidthWhite | o.beamWidthWhite
layout | BeamDrawingInterface | BeamDrawingInterface | bdFractionSize | int | o->m_fractionSize | o.fractionSize
layout | BeamDrawingInterface | BeamDrawingInterface | bdChangingDur | bool | o->m_changingDur | o.changingDur
layout | BeamDrawingInterface | BeamDrawingInterface | bdHasChord | bool | o->m_beamHasChord | o.beamHasChord
layout | BeamDrawingInterface | BeamDrawingInterface | bdMultipleStemDir | bool | o->m_hasMultipleStemDir | o.hasMultipleStemDir
layout | BeamDrawingInterface | BeamDrawingInterface | bdCueSize | bool | o->m_cueSize | o.cueSize
layout | BeamDrawingInterface | BeamDrawingInterface | bdSpanning | bool | o->m_isSpanningElement | o.isSpanningElement
layout | BeamDrawingInterface | BeamDrawingInterface | bdShortestDur | enum | o->m_shortestDur | o.shortestDur.value
layout | BeamDrawingInterface | BeamDrawingInterface | bdNotesStemDir | enum | o->m_notesStemDir | o.notesStemDir.value
layout | BeamDrawingInterface | BeamDrawingInterface | bdCrossStaffRel | enum | o->m_crossStaffRel | o.crossStaffRel.value
# BeamElementCoord leaves m_x, m_yBeam and m_centered uninitialized (beam.h:401): m_x/m_yBeam are
# dumped per segment below, once BeamSegment::CalcBeamInit has set them; m_centered is only
# assigned on some branches and is left out. m_dur/m_breaksec are set when the coords are
