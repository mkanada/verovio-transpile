# Vertical alignment (SystemAligner / StaffAlignment) and floating positioners
# ---------------------------------------------------------------------------------------------
link   | SystemAligner | SystemAligner | saBottom | ref | o->m_bottomAlignment | o.getBottomAlignment()
pos    | StaffAlignment | StaffAlignment | stYRel | int | o->m_yRel | o.getYRel()
layout | StaffAlignment | StaffAlignment | stOverflowAbove | int | o->m_overflowAbove | o.getOverflowAbove()
layout | StaffAlignment | StaffAlignment | stOverflowBelow | int | o->m_overflowBelow | o.getOverflowBelow()
layout | StaffAlignment | StaffAlignment | stOverlap | int | o->m_overlap | o.getOverlap()
layout | StaffAlignment | StaffAlignment | stReqAbove | int | o->m_requestedSpaceAbove | o.getRequestedSpaceAbove()
layout | StaffAlignment | StaffAlignment | stReqBelow | int | o->m_requestedSpaceBelow | o.getRequestedSpaceBelow()
layout | StaffAlignment | StaffAlignment | stReqSpacing | int | o->m_requestedSpacing | o.getRequestedSpacing()
layout | StaffAlignment | StaffAlignment | stStaffHeight | int | o->m_staffHeight | o.getStaffHeight()
layout | StaffAlignment | StaffAlignment | stClefOverflowAbove | int | o->m_scoreDefClefOverflowAbove | o.getScoreDefClefOverflowAbove()
layout | StaffAlignment | StaffAlignment | stClefOverflowBelow | int | o->m_scoreDefClefOverflowBelow | o.getScoreDefClefOverflowBelow()
layout | StaffAlignment | StaffAlignment | stSpacingType | enum | o->m_spacingType | o.getSpacingType().index
layout | StaffAlignment | StaffAlignment | stVersesAbove | ints | SORTED(o->m_verseAboveNs) | SORTED(priv(o, '_verseAboveNs') as Set<int>)
layout | StaffAlignment | StaffAlignment | stVersesBelow | ints | SORTED(o->m_verseBelowNs) | SORTED(priv(o, '_verseBelowNs') as Set<int>)
link   | StaffAlignment | StaffAlignment | stStaff | ref | o->m_staff | o.getStaff()
# The overflow lists keep pointers to objects the C++ may already have deleted (a measure's
# drawing scoreDef clef, recreated between two CalcBBoxOverflows runs): when the allocator
# reuses the address the stale pointer "resolves" to the new object, so the key is not
# reproducible run to run. Kept in the cache group (--nivel=4 / --grupos=cache) only.
cache  | StaffAlignment | StaffAlignment | stOverflowAboveBBs | refs | EACH(b in o->m_overflowAboveBBoxes: b) | EACH(b in (priv(o, '_overflowAboveBBoxes') as List<BoundingBox>): b)
cache  | StaffAlignment | StaffAlignment | stOverflowBelowBBs | refs | EACH(b in o->m_overflowBelowBBoxes: b) | EACH(b in (priv(o, '_overflowBelowBBoxes') as List<BoundingBox>): b)

link   | FloatingObject | FloatingObject | foCurrentPositioner | ref | o->m_currentPositioner | o.currentPositioner
layout | FloatingObject | FloatingObject | foGrpId | int | o->m_drawingGrpId | o.drawingGrpId
layout | FloatingObject | FloatingObject | foMaxYRel | int | o->m_maxDrawingYRel | o.maxDrawingYRel

pos    | FloatingPositioner | FloatingPositioner | fpXRel | int | o->m_drawingXRel | o.getDrawingXRel()
pos    | FloatingPositioner | FloatingPositioner | fpYRel | int | o->m_drawingYRel | o.getDrawingYRel()
layout | FloatingPositioner | FloatingPositioner | fpExtenderW | int | o->m_drawingExtenderWidth | o.getDrawingExtenderWidth()
layout | FloatingPositioner | FloatingPositioner | fpPlace | enum | o->m_place | o.getDrawingPlace().value
layout | FloatingPositioner | FloatingPositioner | fpSpanningType | int | o->m_spanningType | o.getSpanningType()
link   | FloatingPositioner | FloatingPositioner | fpObject | ref | o->m_object | o.getObject()
link   | FloatingPositioner | FloatingPositioner | fpObjectX | ref | o->m_objectX | o.getObjectX()
link   | FloatingPositioner | FloatingPositioner | fpObjectY | ref | o->m_objectY | o.getObjectY()
link   | FloatingPositioner | FloatingPositioner | fpAlignment | ref | o->m_alignment | o.getStaffAlignment()

layout | FloatingCurvePositioner | FloatingCurvePositioner | cvPoints | ints | EACH(p in o->m_points: p.x, p.y) | EACH(p in (priv(o, '_points') as List<Point>): p.x, p.y)
layout | FloatingCurvePositioner | FloatingCurvePositioner | cvThickness | int | o->m_thickness | o.getThickness()
layout | FloatingCurvePositioner | FloatingCurvePositioner | cvDir | enum | o->m_dir | o.getDir().value
layout | FloatingCurvePositioner | FloatingCurvePositioner | cvReqStaffSpace | int | o->m_requestedStaffSpace | o.getRequestedStaffSpace()
layout | FloatingCurvePositioner | FloatingCurvePositioner | cvDiscarded | ints | EACH(s in o->m_spannedElements: s->m_discarded) | EACH(s in o.getSpannedElements(): s.discarded ? 1 : 0)
link   | FloatingCurvePositioner | FloatingCurvePositioner | cvCrossStaff | ref | o->m_crossStaff | o.crossStaff
link   | FloatingCurvePositioner | FloatingCurvePositioner | cvSpanned | refs | EACH(s in o->m_spannedElements: s->m_boundingBox) | EACH(s in o.getSpannedElements(): s.boundingBox)
cache  | FloatingCurvePositioner | FloatingCurvePositioner | cvCachedMinMaxY | int | o->m_cachedMinMaxY | @_cachedMinMaxY
cache  | FloatingCurvePositioner | FloatingCurvePositioner | cvCachedX12 | ints | std::vector<int>{o->m_cachedX12.first, o->m_cachedX12.second} | [priv(o, '_cachedX1') as int, priv(o, '_cachedX2') as int]

