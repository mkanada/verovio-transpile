# fields.manifest — the single source of truth for what the state-snapshot tools dump.
#
# Both sides are GENERATED from this file by
#     (cd verovio_dart && dart run tool/gen_snapshot_fields.dart)
# which writes
#     cpp_probe/snapshot/vrvsnapshot_fields.inc          (C++, compiled into build-probe)
#     verovio_dart/tool/snapshot/fields.g.dart           (Dart)
# so a field has the same name, the same group, the same type and the same position in the
# row on both sides. Never hand-edit the generated files; edit this one, regenerate, rebuild
# the C++ side with `ninja -C build-probe/build` (guide: cpp_probe/snapshot/README.md).
#
# One field per line, seven columns separated by " | ":
#
#   group | C++ class | Dart class | name | type | C++ expression | Dart expression
#
# group        bb | pos | link | layout | cache   (selected with --grupos / --nivel)
# class        the entity is tested with dynamic_cast<const C++ class *> / `is Dart class`;
#              `o` is the entity already cast to it. Interfaces (mixins in Dart) work too.
# name         the JSON key of the field; unique across the whole manifest; not
#              cp / key / class.
# type         int | bool | double | enum | ref | refs | frac | ints
#                enum  C++ side is cast to int; the Dart expression must yield the SAME int
#                      (`.value` for enums carrying the C++ value, `.index` when the Dart enum
#                      mirrors a C++ enum declared without explicit values).
#                ref   a pointer to another entity, dumped as that entity's key.
#                refs  a list of those (use EACH).
#                frac  a Fraction, dumped as [numerator, denominator].
#                ints  a flat list of ints (use EACH / SORTED or a helper).
# expressions  plain C++ / Dart, plus the forms the generator expands:
#                EACH(v in <container>: e1, e2, ...)   flattened list; an element may itself
#                                                      be an EACH (nested lists flatten).
#                SORTED(<ints expression>)             sorted copy (C++ std::set is sorted, a
#                                                      Dart Set keeps insertion order).
#                @_name   (Dart only, whole expression) a private field, read through
#                         dart:mirrors — the Dart snapshot runs from tool/, never from lib/.
#                IF(cond: expr)   (any type) the field is emitted only while `cond`
#                         holds — for C++ members left uninitialized until some point
#                         (their value is heap garbage before it, so dumping them would
#                         make the C++ dump itself non-deterministic). Give the SAME
#                         condition on both sides.
#              The C++ snapshot translation unit is compiled with -fno-access-control, so
#              protected/private members are read directly: prefer the raw member (m_xxx)
#              over a getter, because several getters compute or fill a cache.
#
# RULE: read, never compute. A getter that fills a cache (GetDrawingX, FloatingCurvePositioner
# ::GetPoints, …) changes the state being measured — the snapshot would then "fix" exactly
# the stale-cache divergences it exists to find. Both tools verify the SVG is unchanged.
#
# Functors whose checkpoints are skipped on both sides (queries, never state changes). On the
# Dart side the generator also adds every C++ class deriving from ConstFunctor/DocConstFunctor
# (the C++ side never hooks the const Object::Process overload at all).
@skip-functors ^(Find.*|AddToFlatListFunctor|_?GetAlignmentLeftRightFunctor|CountFunctor)$
#
# Extra imports for names used inside Dart expressions (classes named in the class column are
# imported automatically).
@dart-import package:verovio_dart/src/core/point.dart show Point

# ---------------------------------------------------------------------------------------------
# Every entity: bounding boxes (relative to the drawing position) and the drawing-X/Y cache.
# ---------------------------------------------------------------------------------------------
bb     | BoundingBox | BoundingBox | sx1 | int | o->GetSelfX1() | o.getSelfX1()
bb     | BoundingBox | BoundingBox | sy1 | int | o->GetSelfY1() | o.getSelfY1()
bb     | BoundingBox | BoundingBox | sx2 | int | o->GetSelfX2() | o.getSelfX2()
bb     | BoundingBox | BoundingBox | sy2 | int | o->GetSelfY2() | o.getSelfY2()
bb     | BoundingBox | BoundingBox | cx1 | int | o->GetContentX1() | o.getContentX1()
bb     | BoundingBox | BoundingBox | cy1 | int | o->GetContentY1() | o.getContentY1()
bb     | BoundingBox | BoundingBox | cx2 | int | o->GetContentX2() | o.getContentX2()
bb     | BoundingBox | BoundingBox | cy2 | int | o->GetContentY2() | o.getContentY2()
cache  | BoundingBox | BoundingBox | cdx | int | o->m_cachedDrawingX | o.cachedDrawingX
cache  | BoundingBox | BoundingBox | cdy | int | o->m_cachedDrawingY | o.cachedDrawingY

