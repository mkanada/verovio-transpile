layout | Doc | Doc | dPageH | int | o->m_drawingPageHeight | o.drawingPageHeight
layout | Doc | Doc | dContentW | int | o->m_drawingPageContentWidth | o.drawingPageContentWidth
layout | Doc | Doc | dContentH | int | o->m_drawingPageContentHeight | o.drawingPageContentHeight
layout | Doc | Doc | dMarginB | int | o->m_drawingPageMarginBottom | o.drawingPageMarginBottom
layout | Doc | Doc | dMarginL | int | o->m_drawingPageMarginLeft | o.drawingPageMarginLeft
layout | Doc | Doc | dMarginR | int | o->m_drawingPageMarginRight | o.drawingPageMarginRight
layout | Doc | Doc | dMarginT | int | o->m_drawingPageMarginTop | o.drawingPageMarginTop
# m_drawingBeam* are uninitialized until Doc::UpdatePageDrawingSizes (doc.cpp:2386), which
# also sets m_drawingPageWidth (-1 until then, on both sides).
layout | Doc | Doc | dBeamMaxSlope | double | IF(o->m_drawingPageWidth != -1: o->m_drawingBeamMaxSlope) | IF(o.drawingPageWidth != -1: o.drawingBeamMaxSlope)
layout | Doc | Doc | dBeamW | int | IF(o->m_drawingPageWidth != -1: o->m_drawingBeamWidth) | IF(o.drawingPageWidth != -1: o.drawingBeamWidth)
layout | Doc | Doc | dBeamWhiteW | int | IF(o->m_drawingPageWidth != -1: o->m_drawingBeamWhiteWidth) | IF(o.drawingPageWidth != -1: o.drawingBeamWhiteWidth)
layout | Doc | Doc | dSmuflSize | int | o->m_drawingSmuflFontSize | o.drawingSmuflFontSize
layout | Doc | Doc | dLyricSize | int | o->m_drawingLyricFontSize | o.drawingLyricFontSize
layout | Doc | Doc | dCastOff | bool | o->m_isCastOff | o.isCastOff()

layout | Page | Page | pW | int | o->m_pageWidth | o.pageWidth
layout | Page | Page | pH | int | o->m_pageHeight | o.pageHeight
layout | Page | Page | pMarginB | int | o->m_pageMarginBottom | o.pageMarginBottom
layout | Page | Page | pMarginL | int | o->m_pageMarginLeft | o.pageMarginLeft
layout | Page | Page | pMarginR | int | o->m_pageMarginRight | o.pageMarginRight
layout | Page | Page | pMarginT | int | o->m_pageMarginTop | o.pageMarginTop
layout | Page | Page | pPPU | double | o->m_PPUFactor | o.ppufactor
layout | Page | Page | pJustH | int | o->m_drawingJustifiableHeight | o.drawingJustifiableHeight
layout | Page | Page | pJustSum | double | o->m_justificationSum | o.justificationSum
