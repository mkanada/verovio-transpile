layout | Staff | Staff | ledgerBelowCue | ints | EACH(l in o->m_ledgerLinesBelowCue: (int)l.m_dashes.size(), EACH(d in l.m_dashes: d.m_x1, d.m_x2)) | EACH(l in o.ledgerLinesBelowCue: l.dashes.length, EACH(d in l.dashes: d.x1, d.x2))
