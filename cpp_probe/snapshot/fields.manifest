pos    | System | System | sysXRel | int | o->m_drawingXRel | o.getDrawingXRel()
pos    | System | System | sysYRel | int | o->m_drawingYRel | o.getDrawingYRel()
layout | System | System | sysLeftMar | int | o->m_systemLeftMar | o.systemLeftMar
layout | System | System | sysRightMar | int | o->m_systemRightMar | o.systemRightMar
